# Konfiguration mit Geheimnissen — nur .env.example gehört ins Repo.
# Bewusst als Muster: Varianten wie .env.orig, .env.prod oder .env.bak-2026-01-01
# rutschen sonst an einem blossen ".env" vorbei und landen im Repo.
.env*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tests und Werkzeuge
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Editoren
.vscode/
.idea/
*.swp

# Betriebssystem
.DS_Store
Thumbs.db
