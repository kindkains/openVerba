# openVerba — Beispielkonfiguration
#
# Diese Datei nach .env kopieren und ausfüllen:
#     cp .env.example .env
#
# Alles, was openVerba über seine Umgebung weiß, steht hier drin. Im Code und in der
# docker-compose.yml ist nichts Umgebungsspezifisches hartkodiert.

# --- Anwendung -------------------------------------------------------------------

# Port auf dem Host. Im Container lauscht die Anwendung immer auf 8080.
# Die docker-compose.yml bindet ihn auf 127.0.0.1 — von aussen ist die Anwendung
# damit nur ueber den Reverse-Proxy erreichbar. Soll sie direkt aus dem LAN
# erreichbar sein, dort das "127.0.0.1:" vor dem Port entfernen.
OPENVERBA_PORT=8080

# Signiert die Session-Cookies. PFLICHT — ohne startet die Anwendung nicht.
# Erzeugen mit:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
OPENVERBA_SECRET_KEY=

# Basis für die Links in Reset-Mails. Muss von außen erreichbar sein.
# Beginnt der Wert mit https, setzt openVerba automatisch das Secure-Flag auf allen
# Cookies. Hinter TLS gehoert hier also die oeffentliche Adresse hin.
OPENVERBA_BASE_URL=http://localhost:8080

# Vokabeln pro Lerneinheit.
OPENVERBA_SESSION_SIZE=20

# Tippfehler-Toleranz (Levenshtein-Distanz 1 ab 5 Zeichen Länge).
OPENVERBA_TYPO_TOLERANCE=true

# --- Bootstrap-Admin -------------------------------------------------------------
#
# Wird beim ersten Start angelegt. Existiert der Nutzer schon, passiert nichts.
# Das Passwort muss beim ersten Login geändert werden.

OPENVERBA_ADMIN_USER=admin
OPENVERBA_ADMIN_PASSWORD=

# --- Datenbank -------------------------------------------------------------------

MARIADB_DATABASE=openverba
MARIADB_USER=openverba
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# --- Mailversand (optional) ------------------------------------------------------
#
# Bleibt SMTP_HOST leer, verschickt openVerba keine Mails. Reset-Links stehen dann
# im Admin-Bereich zum Weitergeben bereit — das ist der Normalbetrieb.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=openverba@example.org
SMTP_STARTTLS=true
